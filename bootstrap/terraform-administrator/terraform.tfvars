# The name of the Terraform administrator role.
terraform-admin-role-name = "Terraform Administrator Role"

# The name of the group name in Azure AD to which this role can be assigned.
terraform-admin-group-name = "Terraform Administrator Group"

# Terraform admin group built-in roles.
terraform-admin-ad-group-builtin-roles = [
  "Application Administrator",
  "Attribute Definition Administrator",
  "Attribute Provisioning Administrator",
  "Groups Administrator",
  "Privileged Role Administrator"
]
